# TriageOps server configuration. Copy to .env and fill in. Every value is server side only.
# The file is plain KEY=value lines, so "set -a; source .env; set +a" loads it into a shell.

# Claude API key from https://console.anthropic.com. Without it, tickets are triaged by the keyword fallback.
ANTHROPIC_API_KEY=
# Model for ticket triage. It must accept a forced tool choice.
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5
# Model for the copilot chat agent.
CLAUDE_AGENT_MODEL=claude-sonnet-5-5

# Comma separated Postgres URLs, tried in order. Use the Supabase transaction pooler on port 6543 with role triage_api.
DATABASE_URLS=postgresql://triage_api.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Edge Function that returns gte-small embeddings, and the shared secret it expects in x-embed-secret.
EMBED_URL=https://sdrwlskpdnhjmynxgrnb.supabase.co/functions/v1/embed
EMBED_SECRET=

# HMAC key for /api/webhooks/inbound and /api/webhooks/email. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Meta WhatsApp Cloud API. The verify token is any string you also enter in the Meta app dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/sla.
CRON_SECRET=

# Bearer token that MCP clients must send to /api/mcp.
MCP_TOKEN=

# Optional Slack, Discord or Teams incoming webhook for P1, escalated and SLA breach alerts. Must be https.
ALERT_WEBHOOK_URL=

# Key for hashing client IPs. Raw IPs are never stored. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Abuse limits for the public demo.
DEMO_HOURLY_LIMIT=6
DEMO_DAILY_LIMIT=300
CHAT_HOURLY_LIMIT=20

# Bearer token for the analyst console (/api/admin). Long and random. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Alert body format. auto picks Slack, Discord or a Teams Adaptive Card from the webhook host.
# Set slack, discord, teams or generic to override, for example for a government cloud Teams host.
ALERT_FORMAT=auto
# Optional https address of the dashboard, used for the Open ticket button on Teams cards.
PUBLIC_APP_URL=

# RMM alert intake at /api/webhooks/rmm (NinjaOne and Datto RMM, relayed and signed by n8n).
# HMAC key for that endpoint. If empty, WEBHOOK_SECRET is used. Generate with: openssl rand -hex 32
RMM_WEBHOOK_SECRET=
# Repeat alerts for the same device and condition within this many minutes join one ticket.
RMM_DEDUP_MINUTES=30

# PSA sync. Off unless PSA_PROVIDER is halopsa or autotask and that provider's settings are complete.
PSA_PROVIDER=
PSA_TIMEOUT_SECONDS=8
PSA_MAX_ATTEMPTS=3
PSA_BACKOFF_SECONDS=0.5
# Total time budget across retries, so the serverless function stays inside its 60 second limit.
PSA_DEADLINE_SECONDS=20

# HaloPSA. Create an API application with Client ID and Secret (Services) authentication.
HALOPSA_BASE_URL=
# Optional. Defaults to HALOPSA_BASE_URL/auth.
HALOPSA_AUTH_URL=
HALOPSA_TENANT=
HALOPSA_CLIENT_ID=
HALOPSA_CLIENT_SECRET=
HALOPSA_SCOPE=all
HALOPSA_TICKET_TYPE_ID=
HALOPSA_DEFAULT_CLIENT_ID=
HALOPSA_SITE_ID=
HALOPSA_TEAM_ID=
# Halo priority ids differ per tenant. Map each TriageOps priority to yours.
HALOPSA_PRIORITY_IDS=P1:1,P2:2,P3:3,P4:4

# Autotask. Use an API only user. Without AUTOTASK_BASE_URL the zone is discovered from the username.
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=
AUTOTASK_BASE_URL=
# Company for new tickets. 0 is your own company and is valid.
AUTOTASK_COMPANY_ID=
AUTOTASK_QUEUE_ID=
AUTOTASK_TICKET_TYPE_ID=
AUTOTASK_SOURCE_ID=
AUTOTASK_STATUS_ID=1
# Default Autotask picklist: 4 Critical, 1 High, 2 Medium, 3 Low. Check yours in the Autotask admin pages.
AUTOTASK_PRIORITY_IDS=P1:4,P2:1,P3:2,P4:3
